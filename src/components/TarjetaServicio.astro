---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  servicio: CollectionEntry<'servicios'>;
  destacada?: boolean;
}

const { servicio, destacada = false } = Astro.props;
const { titulo, resumen, icono, imagen, imagenAlt } = servicio.data;
---

<article
  class:list={[
    'tarjeta revelar group relative overflow-hidden hover:-translate-y-1 hover:border-azul-200 hover:shadow-media',
    destacada && 'sm:col-span-2',
  ]}
>
  <div class:list={['relative overflow-hidden', destacada ? 'aspect-[16/7]' : 'aspect-[16/10]']}>
    <Image
      src={imagen}
      alt={imagenAlt}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
      class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
      loading="lazy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-azul-950/55 via-azul-950/5 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute bottom-4 left-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white/95 text-azul-600 shadow-suave backdrop-blur"
    >
      <Icono nombre={icono} tamano={22} />
    </div>
  </div>

  <div class="p-6">
    <h3 class="text-h3">
      <a href={`/servicios/${servicio.id}`} class="after:absolute after:inset-0">
        {titulo}
      </a>
    </h3>
    <p class="mt-3 text-[0.9375rem] leading-relaxed text-hormigon-600">{resumen}</p>
    <p
      class="mt-5 inline-flex items-center gap-2 font-display text-sm font-semibold text-azul-600"
    >
      Ver el detalle
      <Icono
        nombre="flecha"
        tamano={17}
        class="transition-transform duration-300 group-hover:translate-x-1"
      />
    </p>
  </div>
</article>
