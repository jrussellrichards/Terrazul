---
import Icono from './Icono.astro';
import { COMPARATIVA } from '../consts';

const { columnas, filas, nota } = COMPARATIVA;
const indiceTerrazul = columnas.length - 1;
---

<div class="revelar">
  <!-- La tabla desborda en pantallas angostas: scrollea dentro de su caja,
       nunca empuja el ancho de la página. -->
  <div class="-mx-[var(--padding-borde)] overflow-x-auto px-[var(--padding-borde)] sm:mx-0 sm:px-0">
    <table class="w-full min-w-[34rem] border-collapse text-left">
      <caption class="sr-only">
        Qué cubre cada modelo de contratación: distribuidor, contratista aplicador y Terrazul
      </caption>

      <thead>
        <tr>
          <th scope="col" class="w-2/5 pb-4 pr-4 font-display text-sm font-semibold text-hormigon-500">
            Quién cubre qué
          </th>
          {
            columnas.map((columna, i) => (
              <th
                scope="col"
                class:list={[
                  'pb-4 text-center font-display text-sm font-semibold',
                  i === indiceTerrazul
                    ? 'rounded-t-lg bg-azul-500 px-3 py-3 text-white'
                    : 'px-3 text-hormigon-500',
                ]}
              >
                {columna}
              </th>
            ))
          }
        </tr>
      </thead>

      <tbody>
        {
          filas.map((fila, indiceFila) => (
            <tr class="revelar border-t border-hormigon-200">
              <th
                scope="row"
                class="py-4 pr-4 text-[0.9375rem] font-medium text-azul-900"
              >
                {fila.criterio}
              </th>
              {
                fila.cobertura.map((cubre, i) => (
                  <td
                    class:list={[
                      'px-3 py-4 text-center align-middle',
                      i === indiceTerrazul && 'bg-azul-50',
                      i === indiceTerrazul && indiceFila === filas.length - 1 && 'rounded-b-lg',
                    ]}
                  >
                    <span class="sr-only">{cubre ? 'Sí' : 'No'}</span>
                    {
                      cubre ? (
                        <Icono
                          nombre="check"
                          tamano={20}
                          class:list={[
                            'mx-auto',
                            i === indiceTerrazul ? 'text-azul-600' : 'text-hormigon-400',
                          ]}
                        />
                      ) : (
                        <span
                          class="mx-auto block h-0.5 w-4 rounded-full bg-hormigon-300"
                          aria-hidden="true"
                        />
                      )
                    }
                  </td>
                ))
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-6 max-w-2xl text-[0.9375rem] leading-relaxed text-hormigon-500">{nota}</p>
</div>
