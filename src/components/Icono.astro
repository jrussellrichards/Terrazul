const esRelleno = nombre in relleno;
const d = esRelleno ? relleno[nombre]! : trazo[nombre]!;
---

<svg
  viewBox="0 0 24 24"
  width={tamano}
  height={tamano}
  class={clase}
  aria-hidden="true"
  focusable="false"
  fill={esRelleno ? 'currentColor' : 'none'}
  stroke={esRelleno ? 'none' : 'currentColor'}
  stroke-width={esRelleno ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={d}></path>
</svg>
